# OpenClaw gateway (used by run.py via openclaw-sdk auto-detect)
OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789/gateway

# OpenClaw OpenAI-compatible endpoint (used by bots/_llm.py)
OPENCLAW_OPENAI_BASE_URL=http://127.0.0.1:18789/v1

# Bearer token shared between OpenClaw provider config and bot adapters.
# Generate once: `openssl rand -hex 16`
ADAPTER_SECRET=changeme

# OpenAI API key — used by bots/_llm.py for direct LLM calls.
OPENAI_API_KEY=sk-...

# Model passed to the OpenAI Chat Completions API. Examples:
#   gpt-4o-mini  (cheap, fast)
#   gpt-4o
BASE_LLM_MODEL=gpt-4o-mini
